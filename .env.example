# The Ubudian — environment variables. Copy to .env.local. Never commit .env.local.
# "Required" = the app will not boot or a core flow breaks without it.

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only for scripts/apply-migration.ts (pg client against supabase/.temp/pooler-url)
SUPABASE_DB_PASSWORD=

# --- Stripe (tour bookings webhook) ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- AI (required) ---
# Serves the parser, the moderation gate, embeddings and the tag sweep. On the
# free tier the nightly sweep 429s above ~2 concurrent calls.
GEMINI_API_KEY=
STABILITY_AI_API_KEY=

# --- Email (required) ---
RESEND_API_KEY=
# Digest + alerts go here. From-address is hello@theubudian.life (the only verified domain).
ADMIN_EMAIL=
# HMAC key for one-click unsubscribe links; falls back to CRON_SECRET
EMAIL_UNSUB_SECRET=

# --- Cron (required) ---
# Bearer for every /api/cron/* route. Also lives in GitHub repo secrets.
CRON_SECRET=

# --- App ---
NEXT_PUBLIC_SITE_URL=https://theubudian.life

# --- Ingestion adapters (optional; each gates one source) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
WAHA_API_URL=
WAHA_API_KEY=
WAHA_WEBHOOK_SECRET=
WHATSAPP_NUMBER=
EVENTBRITE_API_KEY=
MEETUP_API_KEY=
SERPAPI_API_KEY=
META_PAGE_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
RETREAT_GURU_API_KEY=
RAPIDAPI_KEY=
ALLEVENTS_API_KEY=
APIFY_API_TOKEN=

# --- GitHub repo secrets (not app env) ---
# CRON_SECRET, NEXT_PUBLIC_SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, GEMINI_API_KEY
# CRM_HANDOVER_URL, CRM_HANDOVER_SECRET  — the liveness alert into Ben's CRM
